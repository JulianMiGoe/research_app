rules_version = '2';
// Spielstände liegen unter spielstaende/<20-stelliger Code>. Lesen und Schreiben nur mit Anmeldung,
// Auflisten und Löschen nie. Wer den Code kennt, kommt an den Spielstand: Code für dich behalten.
service cloud.firestore {
  match /databases/{database}/documents {
    match /spielstaende/{code} {
      allow get: if request.auth != null && code.size() == 20;
      allow create, update: if request.auth != null && code.size() == 20
        && request.resource.data.keys().hasOnly(['v', 'savedAt', 'json'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 1000000;
      allow list, delete: if false;
    }
  }
}
